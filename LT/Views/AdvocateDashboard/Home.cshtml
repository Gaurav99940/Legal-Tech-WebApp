@{
    ViewData["Title"] = "Advocate Chamber & Practice Portal";
    ViewData["ParentTitle"] = "Chambers";
    Layout = "~/Views/Shared/_UserDashboardLayout.cshtml";

    var advName = ViewBag.AdvocateName ?? "Senior Adv. Priya Sharma";
    var barNo = ViewBag.BarNo ?? "D/1842/2012";
    var court = ViewBag.Court ?? "High Court of Delhi & Supreme Court";
}

<div class="row g-4 mb-4">
    <!-- Advocate Profile Banner -->
    <div class="col-12">
        <div class="glass-panel p-4 p-lg-5" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(88, 28, 135, 0.6) 100%); border-left: 5px solid #a855f7;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 60px; height: 60px; border-radius: 16px; background: var(--grad-primary); display: flex; align-items: center; justify-content: center; font-size: 1.6rem; color: white; font-weight: bold; box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);">
                        PS
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h3 class="text-white fw-bold mb-0">@advName</h3>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 small"><i class="fa-solid fa-circle-check me-1"></i> Bar Verified</span>
                        </div>
                        <div class="text-secondary small mt-1">
                            <i class="fa-solid fa-id-card text-info me-1"></i> Bar Council Reg: <strong>@barNo</strong> &bull;
                            <i class="fa-solid fa-landmark text-warning ms-2 me-1"></i> Practice: @court
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="UserDashboard" asp-action="Home" class="btn btn-modern-outline btn-sm">
                        <i class="fa-solid fa-user me-1"></i> Switch to Client Portal
                    </a>
                    <a asp-controller="UserCase" asp-action="LegalDrafts" class="btn btn-modern-primary btn-sm">
                        <i class="fa-solid fa-file-signature me-1"></i> Draft Legal Notice
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Advocate KPI Metrics -->
    <div class="col-xl-3 col-md-6">
        <div class="glass-card stat-kpi-card">
            <div>
                <div class="stat-kpi-value text-white">@ViewBag.ActiveBriefs</div>
                <div class="stat-kpi-label">Active Chamber Briefs</div>
                <small class="text-success" style="font-size: 0.72rem;"><i class="fa-solid fa-arrow-up"></i> 3 New this week</small>
            </div>
            <div class="stat-icon-wrapper" style="background: rgba(99, 102, 241, 0.15);"><i class="fa-solid fa-scale-balanced text-primary"></i></div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="glass-card stat-kpi-card">
            <div>
                <div class="stat-kpi-value text-warning">@ViewBag.TodayAppearances</div>
                <div class="stat-kpi-label">Today's Cause List</div>
                <small class="text-warning" style="font-size: 0.72rem;"><i class="fa-solid fa-clock"></i> Next at 11:30 AM (Court 4)</small>
            </div>
            <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.15);"><i class="fa-solid fa-gavel text-warning"></i></div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="glass-card stat-kpi-card">
            <div>
                <div class="stat-kpi-value text-info">@ViewBag.PendingConsultations</div>
                <div class="stat-kpi-label">Client Booking Requests</div>
                <small class="text-info" style="font-size: 0.72rem;"><i class="fa-solid fa-user-plus"></i> 2 Awaiting Acceptance</small>
            </div>
            <div class="stat-icon-wrapper" style="background: rgba(6, 182, 212, 0.15);"><i class="fa-solid fa-calendar-check text-info"></i></div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="glass-card stat-kpi-card">
            <div>
                <div class="stat-kpi-value text-success">@ViewBag.MonthlyRetainers</div>
                <div class="stat-kpi-label">Month Billing / Retainers</div>
                <small class="text-success" style="font-size: 0.72rem;"><i class="fa-solid fa-chart-line"></i> +18% vs Last Month</small>
            </div>
            <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.15);"><i class="fa-solid fa-indian-rupee-sign text-success"></i></div>
        </div>
    </div>
</div>

<!-- Daily Cause List & Client Booking Requests Row -->
<div class="row g-4 mb-4">
    <!-- Today's Court Cause List -->
    <div class="col-lg-7">
        <div class="glass-panel p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-gavel text-warning"></i> Today's Court Appearance Cause List
                </h5>
                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50">4 Matters Listed</span>
            </div>

            <div class="d-flex flex-column gap-3">
                <div class="p-3 rounded-3" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-primary text-white">Item No. 14 &bull; Courtroom 4</span>
                        <span class="fw-bold text-warning small">10:30 AM</span>
                    </div>
                    <h6 class="text-white fw-bold mb-1">XYZ Enterprises vs ABC Global Corp</h6>
                    <small class="text-secondary d-block"><i class="fa-solid fa-landmark text-info me-1"></i> Delhi High Court &bull; Bench: Hon'ble Justice V. K. Sharma (Commercial Division)</small>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-10 small">
                        <span class="text-info">Stage: Final Arguments (O.37 CPC)</span>
                        <span class="text-light">Client: XYZ Enterprises</span>
                    </div>
                </div>

                <div class="p-3 rounded-3" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-warning text-dark fw-bold">Item No. 28 &bull; Courtroom 9</span>
                        <span class="fw-bold text-warning small">02:15 PM</span>
                    </div>
                    <h6 class="text-white fw-bold mb-1">Apex Finlease vs M/S Tech Solutions</h6>
                    <small class="text-secondary d-block"><i class="fa-solid fa-landmark text-info me-1"></i> Patiala House Courts &bull; Special NI Act Court</small>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-10 small">
                        <span class="text-warning">Stage: Complainant Evidence (138 NI Act)</span>
                        <span class="text-light">Client: Apex Finlease</span>
                    </div>
                </div>

                <div class="p-3 rounded-3" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-danger text-white">Item No. 4 &bull; Supplementary List</span>
                        <span class="fw-bold text-warning small">03:45 PM</span>
                    </div>
                    <h6 class="text-white fw-bold mb-1">State of NCT vs Rahul Verma</h6>
                    <small class="text-secondary d-block"><i class="fa-solid fa-landmark text-info me-1"></i> Saket Sessions Court &bull; Courtroom 12</small>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-10 small">
                        <span class="text-danger">Stage: Section 438 Anticipatory Bail Arguments</span>
                        <span class="text-light">Client: Rahul Verma</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Client Consultation Requests -->
    <div class="col-lg-5">
        <div class="glass-panel p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-white fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-calendar-check text-info"></i> Client Consultation Inquiries
                    </h5>
                    <span class="badge bg-info bg-opacity-25 text-info">New Requests</span>
                </div>

                <div class="d-flex flex-column gap-3">
                    <div class="p-3 rounded-3" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="text-white fw-bold mb-0">Vikram Malhotra (MD, Zenith Infotech)</h6>
                                <small class="text-secondary">Matter: Breach of Software License SLA & Claim of ₹1.2 Cr</small>
                            </div>
                            <span class="badge bg-success small">₹4,500 Paid</span>
                        </div>
                        <div class="small text-muted mb-2"><i class="fa-solid fa-calendar me-1"></i> Tomorrow, 05:00 PM &bull; Chamber Video Call</div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-modern-primary flex-grow-1" onclick="alert('Consultation accepted and added to calendar!')"><i class="fa-solid fa-check me-1"></i> Accept</button>
                            <button class="btn btn-sm btn-modern-outline" onclick="alert('Reschedule request sent to client.')"><i class="fa-solid fa-clock-rotate-left"></i></button>
                        </div>
                    </div>

                    <div class="p-3 rounded-3" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="text-white fw-bold mb-0">Suresh Goyal (Proprietor)</h6>
                                <small class="text-secondary">Matter: Section 138 Cheque Bounce of ₹38 Lakhs</small>
                            </div>
                            <span class="badge bg-success small">₹4,500 Paid</span>
                        </div>
                        <div class="small text-muted mb-2"><i class="fa-solid fa-calendar me-1"></i> 06 Oct, 04:30 PM &bull; Chamber In-Person</div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-modern-primary flex-grow-1" onclick="alert('Consultation accepted!')"><i class="fa-solid fa-check me-1"></i> Accept</button>
                            <button class="btn btn-sm btn-modern-outline" onclick="alert('Reschedule request sent.')"><i class="fa-solid fa-clock-rotate-left"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3 pt-3 border-top border-secondary border-opacity-10 text-center">
                <a asp-controller="Hero" asp-action="AskChatBot" class="btn btn-modern-cyan btn-sm w-100">
                    <i class="fa-solid fa-robot me-1"></i> Open AI Case Law & Precedents Finder
                </a>
            </div>
        </div>
    </div>
</div>
