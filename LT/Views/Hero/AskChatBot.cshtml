@{
    ViewData["Title"] = "AI Legal Assistant & Statutory Research";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container py-4 py-lg-5 position-relative" style="z-index: 2;">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <!-- Glassmorphic AI Chat Card -->
            <div class="glass-card shadow-lg overflow-hidden border-0" style="background: rgba(11, 17, 32, 0.88); backdrop-filter: blur(25px);">
                <!-- Header -->
                <div class="p-4 border-bottom border-secondary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center gap-3" style="background: linear-gradient(90deg, rgba(99, 102, 241, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="brand-icon-wrapper animate-pulse-glow" style="width: 48px; height: 48px; border-radius: 14px; background: var(--grad-primary); display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-robot text-white fs-4"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="text-white fw-bold mb-0">LegalTech AI Research Assistant</h4>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 small">Online 24/7</span>
                            </div>
                            <small class="text-secondary">Statutory Search &bull; Indian Penal Code &bull; Constitution &bull; CrPC &bull; BNS 2023</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-modern-outline btn-sm px-3 py-1" onclick="clearChat()">
                            <i class="fa-solid fa-trash-can me-1"></i> Clear
                        </button>
                        <a href="/Hero/BookAdvocate" class="btn btn-modern-primary btn-sm px-3 py-1">
                            <i class="fa-solid fa-user-tie me-1"></i> Consult Advocate
                        </a>
                    </div>
                </div>

                <!-- Quick Suggestion Prompt Chips -->
                <div class="px-4 py-3 border-bottom border-secondary border-opacity-10 d-flex flex-wrap gap-2 align-items-center" style="background: rgba(6, 9, 19, 0.5);">
                    <span class="small text-secondary fw-semibold"><i class="fa-solid fa-bolt text-warning me-1"></i> Popular Queries:</span>
                    <span class="prompt-chip" onclick="askPrompt('302')"><i class="fa-solid fa-scale-balanced"></i> Section 302 IPC</span>
                    <span class="prompt-chip" onclick="askPrompt('Section 138 Cheque Bounce')"><i class="fa-solid fa-money-check"></i> Cheque Bounce 138</span>
                    <span class="prompt-chip" onclick="askPrompt('How to get Anticipatory Bail?')"><i class="fa-solid fa-shield-halved"></i> Anticipatory Bail</span>
                    <span class="prompt-chip" onclick="askPrompt('Article 21 Right to Life')"><i class="fa-solid fa-book-bookmark"></i> Article 21</span>
                    <span class="prompt-chip" onclick="askPrompt('Section 420 Cheating & Fraud')"><i class="fa-solid fa-handcuffs"></i> Section 420 IPC</span>
                    <span class="prompt-chip" onclick="askPrompt('Cyber Crime IT Act 66')"><i class="fa-solid fa-laptop-code"></i> Cyber Fraud IT Act</span>
                </div>

                <!-- Chat History Window -->
                <div class="chat-container-glass" id="chatbox">
                    <!-- Bot Welcome Message -->
                    <div class="chat-bubble bot">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div style="width: 26px; height: 26px; border-radius: 50%; background: var(--grad-primary); display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-scale-balanced text-white" style="font-size: 0.75rem;"></i>
                            </div>
                            <strong class="text-white small">LegalTech AI Engine</strong>
                            <small class="text-muted ms-auto" style="font-size: 0.7rem;">Just now</small>
                        </div>
                        <p class="mb-2 text-light" style="font-size: 0.95rem;">
                            Hello! I am your AI Legal Intelligence Assistant. Ask me any Indian statute, IPC/BNS Section, Constitutional Article, Court procedure, or procedural remedy.
                        </p>
                        <div class="p-2 rounded small" style="background: rgba(255, 255, 255, 0.05); border: 1px dashed rgba(255, 255, 255, 0.15);">
                            💡 <em>Try typing a section number like <strong>"302"</strong>, <strong>"420"</strong>, or asking <strong>"How to file a consumer complaint?"</strong></em>
                        </div>
                    </div>
                </div>

                <!-- Input Field Area -->
                <div class="p-3 p-md-4 border-top border-secondary border-opacity-25" style="background: rgba(6, 9, 19, 0.9);">
                    <form id="chatForm" class="d-flex gap-2">
                        <div class="position-relative flex-grow-1">
                            <input type="text" id="userQuery" class="form-control modern-input ps-4 pe-5 py-3" placeholder="Ask a legal query or search Section (e.g. 302, Article 21, Bail)..." autocomplete="off" required />
                            <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y me-2 text-secondary hover-white border-0" id="btnVoice" title="Voice Search">
                                <i class="fa-solid fa-microphone"></i>
                            </button>
                        </div>
                        <button class="btn btn-modern-primary px-4 py-3" type="submit" id="btnSend">
                            <span class="d-none d-sm-inline">Send</span> <i class="fa-solid fa-paper-plane ms-1"></i>
                        </button>
                    </form>
                    <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                        <small class="text-muted" style="font-size: 0.72rem;">
                            <i class="fa-solid fa-shield-halved text-success me-1"></i> AI answers are backed by Indian statutory codes & judicial precedents.
                        </small>
                        <small class="text-muted" style="font-size: 0.72rem;">Press Enter to send</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#chatForm').on('submit', function (e) {
                e.preventDefault();
                const query = $('#userQuery').val().trim();
                if (!query) return;

                appendUserMessage(query);
                $('#userQuery').val('');
                showTypingIndicator();

                $.ajax({
                    url: '/ChatGPT/AskChatBot',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ query: query }),
                    success: function (data) {
                        removeTypingIndicator();
                        appendBotResponse(data);
                    },
                    error: function () {
                        removeTypingIndicator();
                        appendBotSimpleMessage("I encountered an issue connecting to the statutory database. Please verify your connection or try again.");
                    }
                });
            });

            window.askPrompt = function (text) {
                $('#userQuery').val(text);
                $('#chatForm').submit();
            };

            window.clearChat = function () {
                $('#chatbox').html(`
                    <div class="chat-bubble bot">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div style="width: 26px; height: 26px; border-radius: 50%; background: var(--grad-primary); display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-scale-balanced text-white" style="font-size: 0.75rem;"></i>
                            </div>
                            <strong class="text-white small">LegalTech AI Engine</strong>
                        </div>
                        <p class="mb-0 text-light small">Chat cleared. Ask me any statutory question or section number!</p>
                    </div>
                `);
            };

            function appendUserMessage(text) {
                const bubble = $(`
                    <div class="chat-bubble user">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <strong class="small">You</strong>
                            <small class="opacity-75 ms-auto" style="font-size: 0.7rem;">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</small>
                        </div>
                        <div>${escapeHtml(text)}</div>
                    </div>
                `);
                $('#chatbox').append(bubble);
                scrollToBottom();
            }

            function appendBotResponse(data) {
                const title = data.title || 'Statutory Overview';
                const act = data.act || 'The Code of Law';
                const section = data.section || 'General Provision';
                const desc = data.description || data.summary || 'Details found in legal record.';
                const penalty = data.penalty || '';
                const remedies = data.remedies || '';

                let htmlContent = `
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div style="width: 26px; height: 26px; border-radius: 50%; background: var(--grad-primary); display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-scale-balanced text-white" style="font-size: 0.75rem;"></i>
                        </div>
                        <strong class="text-white small">AI Legal Analysis</strong>
                        <span class="badge bg-primary bg-opacity-25 text-info border border-primary border-opacity-50 small ms-1">${escapeHtml(act)}</span>
                        <small class="text-muted ms-auto" style="font-size: 0.7rem;">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</small>
                    </div>

                    <h5 class="text-white fw-bold mt-2 mb-2 text-gradient">${escapeHtml(title)}</h5>
                    <p class="text-light mb-3" style="line-height: 1.6;">${escapeHtml(desc)}</p>
                `;

                if (penalty) {
                    htmlContent += `
                        <div class="p-2 mb-3 rounded-2" style="background: rgba(244, 63, 94, 0.1); border-left: 3px solid #f43f5e;">
                            <strong class="text-danger small"><i class="fa-solid fa-gavel me-1"></i> Legal Penalty / Nature:</strong>
                            <div class="small text-light mt-1">${escapeHtml(penalty)}</div>
                        </div>
                    `;
                }

                if (remedies) {
                    htmlContent += `
                        <div class="p-2 mb-3 rounded-2" style="background: rgba(6, 182, 212, 0.1); border-left: 3px solid #06b6d4;">
                            <strong class="text-info small"><i class="fa-solid fa-shield-halved me-1"></i> Recommended Legal Remedies & Steps:</strong>
                            <div class="small text-light mt-1" style="white-space: pre-line;">${escapeHtml(remedies)}</div>
                        </div>
                    `;
                }

                htmlContent += `
                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-20 gap-2">
                        <div class="small text-secondary"><i class="fa-solid fa-user-check text-success me-1"></i> Advocate advice recommended</div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-light py-1 px-2" onclick="copyBotText(this)"><i class="fa-regular fa-copy"></i> Copy</button>
                            <a href="/Hero/BookAdvocate" class="btn btn-sm btn-modern-primary py-1 px-3"><i class="fa-solid fa-user-tie me-1"></i> Book Advocate</a>
                        </div>
                    </div>
                `;

                const bubble = $(`<div class="chat-bubble bot">${htmlContent}</div>`);
                $('#chatbox').append(bubble);
                scrollToBottom();
            }

            function appendBotSimpleMessage(text) {
                const bubble = $(`
                    <div class="chat-bubble bot">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div style="width: 26px; height: 26px; border-radius: 50%; background: var(--grad-primary); display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-scale-balanced text-white" style="font-size: 0.75rem;"></i>
                            </div>
                            <strong class="text-white small">AI Assistant</strong>
                        </div>
                        <p class="mb-0 text-light">${escapeHtml(text)}</p>
                    </div>
                `);
                $('#chatbox').append(bubble);
                scrollToBottom();
            }

            function showTypingIndicator() {
                const indicator = $(`
                    <div class="chat-bubble bot typing-indicator-bubble" id="typingIndicator">
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-grow spinner-grow-sm text-info" role="status"></div>
                            <small class="text-secondary">Analyzing statutory provisions...</small>
                        </div>
                    </div>
                `);
                $('#chatbox').append(indicator);
                scrollToBottom();
            }

            function removeTypingIndicator() {
                $('#typingIndicator').remove();
            }

            function scrollToBottom() {
                $('#chatbox').stop().animate({ scrollTop: $('#chatbox')[0].scrollHeight }, 300);
            }

            function escapeHtml(string) {
                return String(string).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            window.copyBotText = function (btn) {
                const text = $(btn).closest('.chat-bubble').find('p').text();
                navigator.clipboard.writeText(text).then(() => {
                    $(btn).html('<i class="fa-solid fa-check"></i> Copied');
                    setTimeout(() => $(btn).html('<i class="fa-regular fa-copy"></i> Copy'), 2000);
                });
            };

            // Voice simulator
            $('#btnVoice').on('click', function () {
                if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
                    const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
                    const rec = new SpeechRec();
                    rec.onstart = function () {
                        $('#btnVoice').addClass('text-danger animate-pulse');
                    };
                    rec.onresult = function (event) {
                        const transcript = event.results[0][0].transcript;
                        $('#userQuery').val(transcript);
                        $('#chatForm').submit();
                    };
                    rec.onend = function () {
                        $('#btnVoice').removeClass('text-danger animate-pulse');
                    };
                    rec.start();
                } else {
                    alert("Voice input is not supported on this browser. Please type your query.");
                }
            });
        });
    </script>
}
