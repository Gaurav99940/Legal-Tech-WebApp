@{
    ViewData["Title"] = "Enterprise Legal Tech Pricing";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container py-4 py-lg-5 position-relative" style="z-index: 2;">
    <div class="text-center mb-5">
        <span class="text-gradient fw-bold text-uppercase small">Transparent Legal Plans</span>
        <h2 class="display-5 fw-bold text-white mt-1">Simple Pricing for Individuals & Law Firms</h2>
        <p class="text-secondary mx-auto" style="max-width: 600px;">
            Scale your legal operations with AI case intelligence, document vaults, and hearing dockets.
        </p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Starter Plan -->
        <div class="col-lg-4 col-md-6">
            <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="text-white fw-bold">Individual / Litigant</h5>
                    <p class="text-secondary small mb-3">For personal case tracking and statutory research.</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold text-white">₹0</span>
                        <span class="text-secondary">/ Free Forever</span>
                    </div>
                    <ul class="list-unstyled small text-light d-flex flex-column gap-3 mb-4">
                        <li><i class="fa-solid fa-check text-success me-2"></i> Track up to 3 Active Cases</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i> 24/7 AI Legal Assistant (IPC / BNS)</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i> Court Hearing SMS / Email Alerts</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i> 100 MB Encrypted Document Vault</li>
                    </ul>
                </div>
                <a href="/Home/SignUp" class="btn btn-modern-outline w-100 py-3">Get Started Free</a>
            </div>
        </div>

        <!-- Pro Advocate Plan (Highlighted) -->
        <div class="col-lg-4 col-md-6">
            <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between animate-pulse-glow" style="border-color: rgba(168, 85, 247, 0.5); background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 27, 75, 0.6) 100%);">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="text-white fw-bold mb-0">Advocate Pro</h5>
                        <span class="badge bg-primary text-white">Most Popular</span>
                    </div>
                    <p class="text-secondary small mb-3">For practicing lawyers and independent counsels.</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold text-gradient">₹1,499</span>
                        <span class="text-secondary">/ month</span>
                    </div>
                    <ul class="list-unstyled small text-light d-flex flex-column gap-3 mb-4">
                        <li><i class="fa-solid fa-check text-info me-2"></i> Unlimited Case Filings & Cause Lists</li>
                        <li><i class="fa-solid fa-check text-info me-2"></i> Priority Verified Profile in Advocate Directory</li>
                        <li><i class="fa-solid fa-check text-info me-2"></i> Automated Client Consultation Booking</li>
                        <li><i class="fa-solid fa-check text-info me-2"></i> AI Legal Notice & Affidavit Generator</li>
                        <li><i class="fa-solid fa-check text-info me-2"></i> 25 GB High-Security Evidence Storage</li>
                    </ul>
                </div>
                <a href="/Home/SignUp" class="btn btn-modern-primary w-100 py-3">Start 14-Day Free Trial</a>
            </div>
        </div>

        <!-- Law Firm Plan -->
        <div class="col-lg-4 col-md-6">
            <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="text-white fw-bold">Law Firm & Enterprise</h5>
                    <p class="text-secondary small mb-3">For multi-advocate law firms and corporate legal teams.</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold text-white">₹4,999</span>
                        <span class="text-secondary">/ month</span>
                    </div>
                    <ul class="list-unstyled small text-light d-flex flex-column gap-3 mb-4">
                        <li><i class="fa-solid fa-check text-success me-2"></i> Multi-User Role Access (Admin, Associates, Clerks)</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i> Custom Cause List Scraper & WhatsApp Alerts</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i> Deep Judicial Precedent Analytics</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i> Unlimited Storage & Tamper-Proof Audit Trails</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i> Dedicated 24/7 Account Manager</li>
                    </ul>
                </div>
                <a href="/Hero/About" class="btn btn-modern-outline w-100 py-3">Contact Sales</a>
            </div>
        </div>
    </div>
</div>
