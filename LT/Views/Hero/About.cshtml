@{
    ViewData["Title"] = "Security Architecture & About LegalTech";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container py-4 py-lg-5 position-relative" style="z-index: 2;">
    <!-- Hero Banner -->
    <div class="text-center mb-5">
        <span class="text-gradient fw-bold text-uppercase small">Mission & Security Framework</span>
        <h2 class="display-5 fw-bold text-white mt-1">Transforming Legal Workflows with Enterprise Security</h2>
        <p class="text-secondary mx-auto" style="max-width: 650px;">
            Built to solve disorganized paper-heavy processes, delayed hearing tracking, and operational overhead in the modern judicial ecosystem.
        </p>
    </div>

    <!-- Security Pillars -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="glass-card tilt-card p-4 h-100">
                <div class="stat-icon-wrapper mb-3" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3);">
                    <i class="fa-solid fa-lock text-success"></i>
                </div>
                <h5 class="text-white fw-bold">AES-256 Vault Encryption</h5>
                <p class="text-secondary small mb-0">
                    All case dockets, evidence PDFs, and client communications are encrypted with military-grade 256-bit AES algorithms with isolated tenant key management.
                </p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card tilt-card p-4 h-100">
                <div class="stat-icon-wrapper mb-3" style="background: rgba(99, 102, 241, 0.15); border-color: rgba(99, 102, 241, 0.3);">
                    <i class="fa-solid fa-user-shield text-primary"></i>
                </div>
                <h5 class="text-white fw-bold">Granular Role-Based Access</h5>
                <p class="text-secondary small mb-0">
                    Strict separation of privileges between Super Admins, Senior Advocates, Associates, and Clients to ensure strict attorney-client privilege.
                </p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card tilt-card p-4 h-100">
                <div class="stat-icon-wrapper mb-3" style="background: rgba(6, 182, 212, 0.15); border-color: rgba(6, 182, 212, 0.3);">
                    <i class="fa-solid fa-file-shield text-info"></i>
                </div>
                <h5 class="text-white fw-bold">DPDP Act 2023 Compliance</h5>
                <p class="text-secondary small mb-0">
                    Fully compliant with India's Digital Personal Data Protection Act 2023, featuring automated consent logs, audit trails, and data erasure controls.
                </p>
            </div>
        </div>
    </div>

    <!-- Tech Stack Summary -->
    <div class="glass-panel p-4 p-md-5 mb-5">
        <h4 class="text-white fw-bold mb-4 text-center">Engineered on Modern Scalable Tech</h4>
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="h5 fw-bold text-white mb-1">.NET 8 / 9 Core</div>
                    <small class="text-secondary">High-Performance Backend</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="h5 fw-bold text-gradient mb-1">MS SQL Server</div>
                    <small class="text-secondary">ACID Enterprise Database</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="h5 fw-bold text-info mb-1">3D WebGL / Canvas</div>
                    <small class="text-secondary">Interactive Fluid UI</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="h5 fw-bold text-success mb-1">Statutory AI</div>
                    <small class="text-secondary">Instant Judicial Search</small>
                </div>
            </div>
        </div>
    </div>
</div>
