@{
    ViewData["Title"] = "Next-Gen AI Legal Platform";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- Hero Section with 3D Canvas Background -->
<section class="hero-section position-relative py-5 py-lg-6" style="min-height: 88vh; display: flex; align-items: center;">
    <div class="container py-4 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <!-- Left Hero Content -->
            <div class="col-lg-7 text-center text-lg-start">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill mb-4" style="background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.35); box-shadow: 0 0 20px rgba(99, 102, 241, 0.2);">
                    <span class="status-dot" style="background: #06b6d4;"></span>
                    <span class="small fw-semibold text-white">AI-Powered Legal Tech 3.0</span>
                    <span class="badge rounded-pill bg-primary px-2 py-1 small">Live Sync</span>
                </div>

                <h1 class="display-4 fw-extrabold text-white mb-4 tracking-tight" style="line-height: 1.15;">
                    Revolutionizing Justice with <span class="text-gradient">3D Digital Intelligence</span> & Case Management
                </h1>

                <p class="lead text-secondary mb-5" style="font-size: 1.15rem; max-width: 600px;">
                    Eliminate paper-heavy disorganized workflows. Securely file cases, track real-time court hearings, access statutory legal AI, and book certified High Court advocates in one seamless platform.
                </p>

                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start mb-5">
                    <a asp-controller="UserCase" asp-action="AddCase" class="btn btn-modern-primary btn-lg px-4 py-3">
                        <i class="fa-solid fa-plus-circle me-2"></i> File New Case Now
                    </a>
                    <a asp-controller="Hero" asp-action="AskChatBot" class="btn btn-modern-outline btn-lg px-4 py-3">
                        <i class="fa-solid fa-wand-magic-sparkles text-info me-2"></i> Try Legal AI Chat
                    </a>
                </div>

                <!-- KPI Metric Pills -->
                <div class="row g-2 g-sm-3 pt-2 text-start">
                    <div class="col-4 col-sm-4">
                        <div class="p-2 p-sm-3 rounded-3 text-center text-sm-start" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <h3 class="h5 h4-sm fw-bold text-white mb-0">15,000+</h3>
                            <small class="text-secondary" style="font-size: 0.75rem;">Cases Tracked</small>
                        </div>
                    </div>
                    <div class="col-4 col-sm-4">
                        <div class="p-2 p-sm-3 rounded-3 text-center text-sm-start" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <h3 class="h5 h4-sm fw-bold text-gradient mb-0">99.8%</h3>
                            <small class="text-secondary" style="font-size: 0.75rem;">Accuracy</small>
                        </div>
                    </div>
                    <div class="col-4 col-sm-4">
                        <div class="p-2 p-sm-3 rounded-3 text-center text-sm-start" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <h3 class="h5 h4-sm fw-bold text-info mb-0">850+</h3>
                            <small class="text-secondary" style="font-size: 0.75rem;">Advocates</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Interactive 3D Card & Live AI Preview -->
            <div class="col-lg-5">
                <div class="glass-card tilt-card p-4 p-md-5 animate-pulse-glow" style="background: rgba(15, 23, 42, 0.85);">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 34px; height: 34px; border-radius: 8px; background: var(--grad-cyan); display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-bolt text-white"></i>
                            </div>
                            <span class="fw-bold text-white">Instant Legal Query</span>
                        </div>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">Online</span>
                    </div>

                    <div class="mb-4">
                        <label class="small text-secondary mb-2 fw-semibold">Ask any IPC / BNS Section or Legal Query:</label>
                        <div class="input-group">
                            <input type="text" id="heroQuickQuery" class="form-control modern-input" placeholder="e.g., 302, bail rules, 138 NI Act..." value="Section 302 Murder & Bail" />
                            <button class="btn btn-modern-cyan px-3" type="button" id="btnHeroQuickSearch">
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Live Query Result Preview Box -->
                    <div class="p-3 rounded-3 mb-4" id="heroResultBox" style="background: rgba(6, 9, 19, 0.8); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-primary text-white" style="font-size: 0.72rem;">Statute Preview</span>
                            <small class="text-muted" style="font-size: 0.72rem;">Indian Penal Code</small>
                        </div>
                        <h6 class="text-white fw-bold mb-1" id="heroResultTitle">Section 302 IPC (Punishment for Murder)</h6>
                        <p class="small text-secondary mb-2" id="heroResultText" style="line-height: 1.5;">
                            Cognizable, Non-Bailable offense triable by Court of Session. Mandatory Life Imprisonment or Capital Punishment.
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-10">
                            <span class="badge bg-danger bg-opacity-25 text-danger" style="font-size: 0.7rem;">Non-Bailable</span>
                            <a href="/AskChatBot" class="small text-info text-decoration-none fw-semibold">Open Full AI Analysis <i class="fa-solid fa-chevron-right ms-1"></i></a>
                        </div>
                    </div>

                    <!-- Quick Shortcuts -->
                    <div class="d-flex flex-wrap gap-2">
                        <span class="prompt-chip" onclick="searchHeroPrompt('Section 420 Cheating')"><i class="fa-solid fa-magnifying-glass"></i> Sec 420 Cheating</span>
                        <span class="prompt-chip" onclick="searchHeroPrompt('Section 138 Cheque Bounce')"><i class="fa-solid fa-magnifying-glass"></i> 138 Cheque Bounce</span>
                        <span class="prompt-chip" onclick="searchHeroPrompt('Article 21 Right to Life')"><i class="fa-solid fa-magnifying-glass"></i> Article 21</span>
                        <span class="prompt-chip" onclick="searchHeroPrompt('Anticipatory Bail 438')"><i class="fa-solid fa-magnifying-glass"></i> Anticipatory Bail</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3D Feature Showcase Cards -->
<section class="py-5 position-relative">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="text-gradient fw-bold text-uppercase small letter-spacing-1">Next-Gen Architecture</span>
            <h2 class="display-5 fw-bold text-white mt-1">Engineered for Modern Law & Fast Justice</h2>
            <p class="text-secondary mx-auto" style="max-width: 650px;">
                Combining enterprise cloud reliability, role-based encryption, and cutting-edge statutory AI.
            </p>
        </div>

        <div class="row g-4">
            <!-- Feature 1: Digital Case Management -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card tilt-card p-4 h-100">
                    <div class="stat-icon-wrapper mb-4" style="background: rgba(99, 102, 241, 0.15); border-color: rgba(99, 102, 241, 0.3);">
                        <i class="fa-solid fa-folder-open text-primary"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Centralized Digital Case Management</h4>
                    <p class="text-secondary small mb-4">
                        Create, track, and organize legal cases, client records, and judge dockets with live status stage indicators from filing to final verdict.
                    </p>
                    <a href="/UserCase/AddCase" class="text-info small fw-semibold text-decoration-none">
                        Manage Cases <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Feature 2: Automated Hearing Calendar -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card tilt-card p-4 h-100">
                    <div class="stat-icon-wrapper mb-4" style="background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.3);">
                        <i class="fa-solid fa-calendar-check text-warning"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Automated Hearing Calendar & Alerts</h4>
                    <p class="text-secondary small mb-4">
                        Instant notifications and synchronized calendar tracking for court appearances, filings, and upcoming deadlines to eliminate human error.
                    </p>
                    <a href="/UserCase/HearingCalendar" class="text-info small fw-semibold text-decoration-none">
                        View Calendar <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Feature 3: Secure Document Vault -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card tilt-card p-4 h-100">
                    <div class="stat-icon-wrapper mb-4" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3);">
                        <i class="fa-solid fa-vault text-success"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Encrypted Document & Evidence Vault</h4>
                    <p class="text-secondary small mb-4">
                        Granular role-based permissions (Admin, Advocate, Client) ensuring strict data confidentiality, tamper-proof audit trails, and instant PDF previews.
                    </p>
                    <a href="/UserCase/DocumentVault" class="text-info small fw-semibold text-decoration-none">
                        Open Vault <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Feature 4: AI Statutory Assistant -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card tilt-card p-4 h-100">
                    <div class="stat-icon-wrapper mb-4" style="background: rgba(6, 182, 212, 0.15); border-color: rgba(6, 182, 212, 0.3);">
                        <i class="fa-solid fa-brain text-info"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-2">AI Statutory & Constitutional Research</h4>
                    <p class="text-secondary small mb-4">
                        Natural language statutory search across IPC, BNS, CrPC, CPC, and Constitution articles with procedural remedies and penalty insights.
                    </p>
                    <a href="/AskChatBot" class="text-info small fw-semibold text-decoration-none">
                        Ask AI Assistant <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Feature 5: Advocate Consultation Booking -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card tilt-card p-4 h-100">
                    <div class="stat-icon-wrapper mb-4" style="background: rgba(168, 85, 247, 0.15); border-color: rgba(168, 85, 247, 0.3);">
                        <i class="fa-solid fa-gavel text-purple"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Verified Advocate Directory & Booking</h4>
                    <p class="text-secondary small mb-4">
                        Discover top legal practitioners filtered by specialization, experience, and win rate. Book video/court consultation slots with instant confirmation.
                    </p>
                    <a href="/Hero/BookAdvocate" class="text-info small fw-semibold text-decoration-none">
                        Find Advocates <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Feature 6: Legal Drafts & Notice Generator -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card tilt-card p-4 h-100">
                    <div class="stat-icon-wrapper mb-4" style="background: rgba(244, 63, 94, 0.15); border-color: rgba(244, 63, 94, 0.3);">
                        <i class="fa-solid fa-file-signature text-danger"></i>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Automated Legal Notice & Drafts Studio</h4>
                    <p class="text-secondary small mb-4">
                        Generate legally compliant Cheque Bounce Notices, Rent Eviction Notices, RTI Applications, and Bail Petitions in seconds.
                    </p>
                    <a href="/UserCase/LegalDrafts" class="text-info small fw-semibold text-decoration-none">
                        Create Draft <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Interactive Workflow Stepper Section -->
<section class="py-5 position-relative" style="background: rgba(11, 17, 32, 0.5);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="text-gradient fw-bold text-uppercase small">Seamless 4-Step Process</span>
            <h2 class="display-6 fw-bold text-white mt-1">How Legal Tech Powers Your Workflow</h2>
        </div>

        <div class="row g-4 text-center">
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card p-4 h-100">
                    <div class="mb-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 50%; background: var(--grad-primary); color: white; font-weight: bold; font-size: 1.2rem;">
                        1
                    </div>
                    <h5 class="text-white fw-bold">File / Import Case</h5>
                    <p class="text-secondary small mb-0">Enter court details, opposing parties, and upload petitions or FIR documents securely.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card p-4 h-100">
                    <div class="mb-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 50%; background: var(--grad-cyan); color: white; font-weight: bold; font-size: 1.2rem;">
                        2
                    </div>
                    <h5 class="text-white fw-bold">AI Case Indexing</h5>
                    <p class="text-secondary small mb-0">Our legal engine indexes statutory provisions, precedents, and hearing timelines automatically.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card p-4 h-100">
                    <div class="mb-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 50%; background: var(--grad-emerald); color: white; font-weight: bold; font-size: 1.2rem;">
                        3
                    </div>
                    <h5 class="text-white fw-bold">Track Hearing Docket</h5>
                    <p class="text-secondary small mb-0">Receive automated countdown alerts, judge cause lists, and evidence deadlines.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card p-4 h-100">
                    <div class="mb-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 50%; background: var(--grad-sunset); color: white; font-weight: bold; font-size: 1.2rem;">
                        4
                    </div>
                    <h5 class="text-white fw-bold">Verdict & Enforcement</h5>
                    <p class="text-secondary small mb-0">Record final orders, decree satisfaction, and generate compliance reports with one click.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-5 position-relative">
    <div class="container py-4">
        <div class="glass-panel p-5 text-center position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(168, 85, 247, 0.2) 100%); border-color: rgba(168, 85, 247, 0.4);">
            <h2 class="display-5 fw-bold text-white mb-3">Ready to Modernize Your Legal Practice?</h2>
            <p class="text-secondary lead mx-auto mb-4" style="max-width: 600px;">
                Join hundreds of advocates and law firms managing their active dockets on India's most advanced 3D legal platform.
            </p>
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a asp-controller="UserDashboard" asp-action="Home" class="btn btn-modern-primary btn-lg px-5 py-3">
                    <i class="fa-solid fa-gauge me-2"></i> Launch Digital Portal
                </a>
                <a asp-controller="Hero" asp-action="AskChatBot" class="btn btn-modern-outline btn-lg px-4 py-3">
                    <i class="fa-solid fa-robot me-2"></i> Open AI Assistant
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function searchHeroPrompt(query) {
            $('#heroQuickQuery').val(query);
            runHeroSearch(query);
        }

        function runHeroSearch(query) {
            $.ajax({
                url: '/ChatGPT/AskChatBot',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ query: query }),
                success: function (data) {
                    $('#heroResultTitle').text(data.title || 'Legal Provision Found');
                    $('#heroResultText').text(data.description || data.summary || 'Details loaded successfully.');
                },
                error: function () {
                    $('#heroResultTitle').text('Search Completed');
                    $('#heroResultText').text('Please click below to launch the dedicated full-screen AI Legal Research Engine.');
                }
            });
        }

        $('#btnHeroQuickSearch').on('click', function () {
            const val = $('#heroQuickQuery').val();
            if (val) runHeroSearch(val);
        });

        $('#heroQuickQuery').on('keypress', function (e) {
            if (e.which === 13) {
                const val = $(this).val();
                if (val) runHeroSearch(val);
            }
        });
    </script>
}
