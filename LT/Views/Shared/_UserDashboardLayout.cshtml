@{
    var userName = Context.Request.HttpContext.Session.GetString("name") ?? "Adv. Gaurav Singh";
    var menuItems = Context.Request.HttpContext.Session.GetString("menuitem");
    var copyRightContent = Context.Request.HttpContext.Session.GetString("copyRightContent") ?? "Copyright &copy; 2026 LegalTech AI Platform. All rights reserved.";
    var profilepicture = Context.Request.HttpContext.Session.GetString("profilepicture") ?? "avtar.png";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - LegalTech Portal</title>
    
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="/images/fevicon.ico" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Bootstrap 5 & FontAwesome 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.css" />
    
    <link href="~/css/modern-legaltech.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

    <style>
        :root, [data-theme="dark"], body:not([data-theme="light"]) {
            --bs-body-color: #ffffff !important;
            color-scheme: dark !important;
        }
        input, select, textarea, .form-control, .modern-input, .input-group .form-control {
            color: #ffffff !important;
            -webkit-text-fill-color: #ffffff !important;
            caret-color: #ffffff !important;
            background-color: #0f172a !important;
            border: 1px solid rgba(255, 255, 255, 0.25) !important;
        }
        input:focus, select:focus, textarea:focus, .form-control:focus, .modern-input:focus, .input-group .form-control:focus {
            color: #ffffff !important;
            -webkit-text-fill-color: #ffffff !important;
            caret-color: #ffffff !important;
            background-color: #141e33 !important;
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.35) !important;
        }
        [data-theme="light"] input, [data-theme="light"] select, [data-theme="light"] textarea,
        [data-theme="light"] .form-control, [data-theme="light"] .modern-input, [data-theme="light"] .input-group .form-control,
        body.light-theme input, body.light-theme select, body.light-theme textarea,
        body.light-theme .form-control, body.light-theme .modern-input, body.light-theme .input-group .form-control {
            color: #0f172a !important;
            -webkit-text-fill-color: #0f172a !important;
            caret-color: #0f172a !important;
            background-color: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
        }
        [data-theme="light"] input:focus, [data-theme="light"] select:focus, [data-theme="light"] textarea:focus,
        [data-theme="light"] .form-control:focus, [data-theme="light"] .modern-input:focus, [data-theme="light"] .input-group .form-control:focus,
        body.light-theme input:focus, body.light-theme select:focus, body.light-theme textarea:focus,
        body.light-theme .form-control:focus, body.light-theme .modern-input:focus, body.light-theme .input-group .form-control:focus {
            color: #0f172a !important;
            -webkit-text-fill-color: #0f172a !important;
            caret-color: #0f172a !important;
            background-color: #ffffff !important;
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2) !important;
        }
    </style>

    <script>
        (function () {
            const savedTheme = localStorage.getItem('legaltech_theme') || 'dark';
            if (savedTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>
<body>
    <!-- Top Floating Glass Navigation Bar -->
    <nav class="navbar fixed-top modern-navbar">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center">
                <!-- Mobile Sidebar Toggle -->
                <button class="btn btn-outline-light d-lg-none me-3 p-2 border-0" type="button" id="sidebarToggle">
                    <i class="fa-solid fa-bars-staggered fs-5"></i>
                </button>

                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center text-decoration-none" asp-controller="Hero" asp-action="Index">
                    <div class="brand-icon-wrapper me-2" style="width: 38px; height: 38px; border-radius: 10px; background: var(--grad-primary); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);">
                        <i class="fa-solid fa-scale-balanced text-white"></i>
                    </div>
                    <span class="fs-4 fw-bold text-white">Legal<span class="text-gradient">Tech</span></span>
                    <span class="brand-badge d-none d-sm-inline">PRO</span>
                </a>
            </div>

            <!-- Top Search & User Profile -->
            <div class="d-flex align-items-center gap-2">
                <!-- Theme Mode Toggle -->
                <button class="btn-theme-toggle" id="themeToggleBtn" title="Toggle Bright / Dark Mode" type="button">
                    <i class="fa-solid fa-sun" id="themeToggleIcon"></i>
                </button>

                <a asp-controller="Hero" asp-action="AskChatBot" class="btn btn-modern-cyan btn-sm px-3 py-2 d-none d-md-inline-flex">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Ask AI Legal
                </a>

                <div class="dropdown">
                    <a class="d-flex align-items-center text-decoration-none dropdown-toggle p-1 rounded-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <img src="/avtar/@profilepicture" alt="@userName" class="rounded-circle" style="width: 34px; height: 34px; object-fit: cover;" onerror="this.src='/images/fevicon.ico';" />
                        <span class="text-white small fw-semibold mx-2 d-none d-sm-inline">@userName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end glass-dropdown-menu">
                        <li>
                            <div class="px-3 py-2 border-bottom border-secondary border-opacity-25">
                                <div class="fw-bold text-white small">@userName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Client / Legal Practitioner</div>
                            </div>
                        </li>
                        <li><a class="glass-dropdown-item" asp-controller="UserDashboard" asp-action="Home"><i class="fa-solid fa-chart-pie text-info"></i> Dashboard</a></li>
                        <li><a class="glass-dropdown-item" asp-controller="UserCase" asp-action="AddCase"><i class="fa-solid fa-folder text-purple"></i> My Cases</a></li>
                        <li><a class="glass-dropdown-item" asp-controller="UserCase" asp-action="DocumentVault"><i class="fa-solid fa-vault text-success"></i> Document Vault</a></li>
                        <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                        <li><a class="glass-dropdown-item text-danger" asp-controller="Home" asp-action="logout"><i class="fa-solid fa-power-off text-danger"></i> Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Modern Glass Sidebar -->
    <aside class="glass-sidebar" id="dashboardSidebar">
        <div class="px-4 mb-4">
            <div class="p-3 rounded-3" style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2);">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="status-dot" style="background: #10b981;"></span>
                    <span class="small fw-semibold text-white">System Active</span>
                </div>
                <div class="text-muted" style="font-size: 0.75rem;">Delhi High Court Synced</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(menuItems))
        {
            @Html.Raw(menuItems)
        }
        else
        {
            <ul class="nav flex-column sidebar-nav-list">
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserDashboard" ? "active" : "")" asp-controller="UserDashboard" asp-action="Home">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AddCase" ? "active" : "")" asp-controller="UserCase" asp-action="AddCase">
                        <i class="fa-solid fa-folder-open"></i>
                        <span>Manage Cases</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "HearingCalendar" ? "active" : "")" asp-controller="UserCase" asp-action="HearingCalendar">
                        <i class="fa-solid fa-calendar-days"></i>
                        <span>Hearing Calendar</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "DocumentVault" ? "active" : "")" asp-controller="UserCase" asp-action="DocumentVault">
                        <i class="fa-solid fa-vault"></i>
                        <span>Document Vault</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdvocateBooking" ? "active" : "")" asp-controller="UserCase" asp-action="AdvocateBooking">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Book Advocate</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "LegalDrafts" ? "active" : "")" asp-controller="UserCase" asp-action="LegalDrafts">
                        <i class="fa-solid fa-file-signature"></i>
                        <span>Legal Drafts</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link" asp-controller="Hero" asp-action="AskChatBot">
                        <i class="fa-solid fa-robot"></i>
                        <span>AI Legal Assistant</span>
                    </a>
                </li>
            </ul>
        }

        <div class="px-4 mt-4 pt-4 border-top border-secondary border-opacity-10">
            <a asp-controller="Home" asp-action="logout" class="sidebar-nav-link text-danger">
                <i class="fa-solid fa-arrow-right-from-bracket text-danger"></i>
                <span>Sign Out</span>
            </a>
        </div>
    </aside>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

    <!-- Main Dashboard Content Area -->
    <main class="dashboard-content-area position-relative" style="z-index: 2;">
        <div class="container-fluid">
            <!-- Header Breadcrumb & Actions -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small">
                            <li class="breadcrumb-item"><a href="/UserDashboard/Home" class="text-secondary text-decoration-none">Portal</a></li>
                            <li class="breadcrumb-item"><a href="#" class="text-secondary text-decoration-none">@ViewData["ParentTitle"]</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                    <h2 class="h3 fw-bold text-white mb-0">@ViewData["Title"]</h2>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="UserCase" asp-action="AddCase" class="btn btn-modern-primary btn-sm">
                        <i class="fa-solid fa-plus me-1"></i> File New Case
                    </a>
                    <a asp-controller="Hero" asp-action="AskChatBot" class="btn btn-modern-outline btn-sm">
                        <i class="fa-solid fa-robot me-1"></i> Quick AI Search
                    </a>
                </div>
            </div>

            @RenderBody()
        </div>
    </main>

    <!-- Floating AI Assistant Widget -->
    <partial name="_FloatingAIAssistant" />

    <!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Mobile Sidebar toggle & backdrop handlers
        const sidebar = document.getElementById('dashboardSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggleBtn = document.getElementById('sidebarToggle');

        function openSidebar() {
            sidebar?.classList.add('show');
            backdrop?.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            sidebar?.classList.remove('show');
            backdrop?.classList.remove('show');
            document.body.style.overflow = 'auto';
        }

        toggleBtn?.addEventListener('click', function () {
            if (sidebar?.classList.contains('show')) {
                closeSidebar();
            } else {
                openSidebar();
            }
        });

        backdrop?.addEventListener('click', closeSidebar);

        document.querySelectorAll('.sidebar-nav-link').forEach(link => {
            link.addEventListener('click', function () {
                if (window.innerWidth < 992) {
                    closeSidebar();
                }
            });
        });

        function updateThemeIcons() {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            const icon = document.getElementById('themeToggleIcon');
            if (icon) {
                if (isLight) {
                    icon.className = 'fa-solid fa-moon text-primary';
                } else {
                    icon.className = 'fa-solid fa-sun text-warning';
                }
            }
        }
        updateThemeIcons();

        document.getElementById('themeToggleBtn')?.addEventListener('click', function () {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            const newTheme = isLight ? 'dark' : 'light';
            if (newTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            } else {
                document.documentElement.removeAttribute('data-theme');
            }
            localStorage.setItem('legaltech_theme', newTheme);
            updateThemeIcons();
        });

        $(document).on('hidden.bs.modal', '.modal', function () {
            if (!$('.modal.show').length) {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css('overflow', 'auto');
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
