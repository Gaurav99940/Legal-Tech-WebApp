@model List<LT.Model.Models.UserCaseModels.UserCourtCaseDetails>
@{
    ViewData["Title"] = "Secure Document & Evidence Vault";
    ViewData["ParentTitle"] = "Case Management";
    Layout = "~/Views/Shared/_UserDashboardLayout.cshtml";
}

<div class="row g-4">
    <!-- Vault Security Overview Card -->
    <div class="col-12">
        <div class="glass-panel p-4 p-lg-5" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(6, 78, 59, 0.5) 100%);">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--grad-emerald); display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-vault text-white fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h3 class="text-white fw-bold mb-0">Encrypted Document Repository</h3>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 small">AES-256</span>
                        </div>
                        <small class="text-secondary">Tamper-proof evidence storage, petitions, FIRs, and certified court decrees</small>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-modern-primary btn-sm px-4" onclick="$('#vaultUploadModal').modal('show')">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload Document
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Filters -->
    <div class="col-12">
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-modern-cyan btn-sm px-3" onclick="filterDocs('all')"><i class="fa-solid fa-layer-group me-1"></i> All Files</button>
            <button class="btn btn-modern-outline btn-sm px-3" onclick="filterDocs('petition')"><i class="fa-solid fa-file-lines me-1"></i> Petitions & Writs</button>
            <button class="btn btn-modern-outline btn-sm px-3" onclick="filterDocs('evidence')"><i class="fa-solid fa-file-shield me-1"></i> Evidence & Statements</button>
            <button class="btn btn-modern-outline btn-sm px-3" onclick="filterDocs('orders')"><i class="fa-solid fa-gavel me-1"></i> Court Orders & Decrees</button>
            <button class="btn btn-modern-outline btn-sm px-3" onclick="filterDocs('vakalatnama')"><i class="fa-solid fa-signature me-1"></i> Vakalatnama</button>
        </div>
    </div>

    <!-- Document Grid -->
    <div class="col-12">
        <div class="row g-4" id="documentGrid">
            <!-- Doc 1 -->
            <div class="col-lg-4 col-md-6 doc-card" data-cat="petition">
                <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="stat-icon-wrapper" style="background: rgba(99, 102, 241, 0.15); border-color: rgba(99, 102, 241, 0.3);">
                                <i class="fa-solid fa-file-pdf text-danger fs-3"></i>
                            </div>
                            <span class="badge bg-primary bg-opacity-25 text-info border border-primary border-opacity-50 small">Petition</span>
                        </div>
                        <h6 class="text-white fw-bold mb-1">Arbitration_Statement_Of_Claim.pdf</h6>
                        <small class="text-secondary d-block mb-3">Matter: XYZ Enterprises vs ABC Global Corp</small>
                        <div class="p-2 rounded small text-muted mb-3" style="background: rgba(255, 255, 255, 0.03);">
                            <div>Size: <strong>2.4 MB</strong> &bull; Uploaded: <strong>@(DateTime.Now.AddDays(-10).ToString("dd MMM yyyy"))</strong></div>
                            <div>Hash: <span class="font-monospace" style="font-size: 0.68rem;">sha256:e8f910a3...</span></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-modern-outline btn-sm w-50" onclick="alert('Viewing secure document in encrypted PDF reader...')"><i class="fa-solid fa-eye me-1"></i> Preview</button>
                        <button class="btn btn-modern-primary btn-sm w-50" onclick="alert('Downloading authenticated PDF copy...')"><i class="fa-solid fa-download me-1"></i> Download</button>
                    </div>
                </div>
            </div>

            <!-- Doc 2 -->
            <div class="col-lg-4 col-md-6 doc-card" data-cat="evidence">
                <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3);">
                                <i class="fa-solid fa-file-shield text-success fs-3"></i>
                            </div>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 small">Evidence</span>
                        </div>
                        <h6 class="text-white fw-bold mb-1">Bank_Return_Memo_Sec138.pdf</h6>
                        <small class="text-secondary d-block mb-3">Matter: XYZ Logistics Ltd vs PQR Retailers</small>
                        <div class="p-2 rounded small text-muted mb-3" style="background: rgba(255, 255, 255, 0.03);">
                            <div>Size: <strong>1.1 MB</strong> &bull; Uploaded: <strong>@(DateTime.Now.AddDays(-15).ToString("dd MMM yyyy"))</strong></div>
                            <div>Hash: <span class="font-monospace" style="font-size: 0.68rem;">sha256:4b92c1ff...</span></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-modern-outline btn-sm w-50" onclick="alert('Viewing secure document in encrypted PDF reader...')"><i class="fa-solid fa-eye me-1"></i> Preview</button>
                        <button class="btn btn-modern-primary btn-sm w-50" onclick="alert('Downloading authenticated PDF copy...')"><i class="fa-solid fa-download me-1"></i> Download</button>
                    </div>
                </div>
            </div>

            <!-- Doc 3 -->
            <div class="col-lg-4 col-md-6 doc-card" data-cat="orders">
                <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.3);">
                                <i class="fa-solid fa-stamp text-warning fs-3"></i>
                            </div>
                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 small">Court Decree</span>
                        </div>
                        <h6 class="text-white fw-bold mb-1">Final_Recovery_Decree_Order.pdf</h6>
                        <small class="text-secondary d-block mb-3">Matter: XYZ Holdings vs Apex Goods Supplier</small>
                        <div class="p-2 rounded small text-muted mb-3" style="background: rgba(255, 255, 255, 0.03);">
                            <div>Size: <strong>4.8 MB</strong> &bull; Uploaded: <strong>@(DateTime.Now.AddDays(-20).ToString("dd MMM yyyy"))</strong></div>
                            <div>Hash: <span class="font-monospace" style="font-size: 0.68rem;">sha256:99da182b...</span></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-modern-outline btn-sm w-50" onclick="alert('Viewing secure document in encrypted PDF reader...')"><i class="fa-solid fa-eye me-1"></i> Preview</button>
                        <button class="btn btn-modern-primary btn-sm w-50" onclick="alert('Downloading authenticated PDF copy...')"><i class="fa-solid fa-download me-1"></i> Download</button>
                    </div>
                </div>
            </div>

            <!-- Doc 4 -->
            <div class="col-lg-4 col-md-6 doc-card" data-cat="vakalatnama">
                <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="stat-icon-wrapper" style="background: rgba(168, 85, 247, 0.15); border-color: rgba(168, 85, 247, 0.3);">
                                <i class="fa-solid fa-signature text-purple fs-3"></i>
                            </div>
                            <span class="badge bg-purple bg-opacity-25 text-purple border border-purple border-opacity-50 small">Vakalatnama</span>
                        </div>
                        <h6 class="text-white fw-bold mb-1">Signed_Vakalatnama_AdvPriyaSharma.pdf</h6>
                        <small class="text-secondary d-block mb-3">Matter: XYZ Enterprises vs ABC Global Corp</small>
                        <div class="p-2 rounded small text-muted mb-3" style="background: rgba(255, 255, 255, 0.03);">
                            <div>Size: <strong>850 KB</strong> &bull; Uploaded: <strong>@(DateTime.Now.AddDays(-25).ToString("dd MMM yyyy"))</strong></div>
                            <div>Hash: <span class="font-monospace" style="font-size: 0.68rem;">sha256:fa2301c9...</span></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-modern-outline btn-sm w-50" onclick="alert('Viewing secure document in encrypted PDF reader...')"><i class="fa-solid fa-eye me-1"></i> Preview</button>
                        <button class="btn btn-modern-primary btn-sm w-50" onclick="alert('Downloading authenticated PDF copy...')"><i class="fa-solid fa-download me-1"></i> Download</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upload Document Modal -->
<div class="modal fade" id="vaultUploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel border-0 text-white" style="background: rgba(11, 17, 32, 0.96); backdrop-filter: blur(30px);">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold text-white"><i class="fa-solid fa-cloud-arrow-up text-info me-2"></i> Upload Evidence / Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="vaultUploadForm" onsubmit="handleDocUpload(event)">
                    <div class="mb-3">
                        <label class="modern-label">Document Title</label>
                        <input type="text" id="docUploadTitle" class="form-control modern-input" required placeholder="e.g., Certified Order Sheet Bench 4" />
                    </div>
                    <div class="mb-3">
                        <label class="modern-label">Associated Case Matter</label>
                        <input type="text" id="docUploadMatter" class="form-control modern-input" placeholder="e.g., XYZ Enterprises vs ABC Corp" value="XYZ Enterprises vs ABC Global Corp" />
                    </div>
                    <div class="mb-3">
                        <label class="modern-label">Document Category</label>
                        <select id="docUploadCategory" class="form-select modern-select" required>
                            <option value="petition">Petition / Plaint / Writ</option>
                            <option value="evidence">Evidence / Bank Memo / Invoices</option>
                            <option value="orders">Court Order / Decree</option>
                            <option value="vakalatnama">Signed Vakalatnama</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="modern-label">Select PDF / Evidence File</label>
                        <input type="file" id="docUploadFile" class="form-control modern-input" required accept=".pdf,.doc,.docx,.png,.jpg" />
                    </div>
                    <button type="submit" class="btn btn-modern-primary w-100 py-3">
                        <i class="fa-solid fa-lock me-2"></i> Encrypt & Upload to Vault
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterDocs(cat) {
            if (cat === 'all') {
                $('.doc-card').fadeIn();
            } else {
                $('.doc-card').each(function () {
                    if ($(this).data('cat') === cat) $(this).fadeIn();
                    else $(this).fadeOut();
                });
            }
        }

        function handleDocUpload(e) {
            e.preventDefault();
            const title = $('#docUploadTitle').val();
            const matter = $('#docUploadMatter').val();
            const cat = $('#docUploadCategory').val();

            const newCard = $(`
                <div class="col-lg-4 col-md-6 doc-card" data-cat="${cat}">
                    <div class="glass-card tilt-card p-4 h-100 d-flex flex-column justify-content-between" style="border-color: rgba(16, 185, 129, 0.4) !important;">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3);">
                                    <i class="fa-solid fa-file-pdf text-success fs-3"></i>
                                </div>
                                <span class="badge bg-success text-white small">New Upload</span>
                            </div>
                            <h6 class="text-white fw-bold mb-1">${title}.pdf</h6>
                            <small class="text-secondary d-block mb-3">Matter: ${matter}</small>
                            <div class="p-2 rounded small text-muted mb-3" style="background: rgba(255, 255, 255, 0.03);">
                                <div>Size: <strong>1.8 MB</strong> &bull; Uploaded: <strong>Just Now</strong></div>
                                <div>Hash: <span class="font-monospace" style="font-size: 0.68rem;">sha256:7a41c28f...</span></div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-modern-outline btn-sm w-50" onclick="alert('Viewing secure document in encrypted reader...')"><i class="fa-solid fa-eye me-1"></i> Preview</button>
                            <button class="btn btn-modern-primary btn-sm w-50" onclick="alert('Downloading authenticated PDF copy...')"><i class="fa-solid fa-download me-1"></i> Download</button>
                        </div>
                    </div>
                </div>
            `);

            $('#documentGrid').prepend(newCard);
            $('#vaultUploadModal').modal('hide');
            alert('Document encrypted with AES-256 and uploaded successfully to Vault!');
            $('#vaultUploadForm')[0].reset();
        }
    </script>
}
