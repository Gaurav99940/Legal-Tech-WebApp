@{
    ViewData["Title"] = "Automated Legal Notices & Drafts Studio";
    ViewData["ParentTitle"] = "Legal Tools";
    Layout = "~/Views/Shared/_UserDashboardLayout.cshtml";
}

<div class="row g-4">
    <div class="col-12">
        <div class="glass-panel p-4 p-lg-5" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(136, 19, 55, 0.5) 100%);">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--grad-sunset); display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-file-signature text-white fs-4"></i>
                    </div>
                    <div>
                        <h3 class="text-white fw-bold mb-0">Automated Legal Notice & Statutory Draft Studio</h3>
                        <small class="text-secondary">Generate 13+ statutory notices, RTIs, recovery drafts, and eviction notices formatted for 1-page A4 printing</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="glass-panel p-4">
            <h5 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-sliders text-info"></i> Notice Configuration
            </h5>

            <form id="draftForm">
                <div class="mb-3">
                    <label class="modern-label">Select Statutory Notice Category</label>
                    <select id="draftType" class="form-select modern-select" onchange="updateDraftPreview()">
                        <option value="138">1. Section 138 NI Act - Cheque Dishonour Demand Notice</option>
                        <option value="eviction">2. Section 106 TPA - Tenant Eviction & Rent Arrears Notice</option>
                        <option value="recovery">3. Order 37 CPC - Summary Suit Debt & Commercial Recovery Notice</option>
                        <option value="consumer">4. Consumer Protection Act 2019 - Deficiency of Service Notice</option>
                        <option value="salary">5. Payment of Wages Act - Unpaid Salary & Arrears Notice</option>
                        <option value="defamation">6. Sec 499/500 IPC/BNS - Defamation & Damages Cease & Desist</option>
                        <option value="contract">7. Indian Contract Act 1872 - Breach of Contract & Specific Performance</option>
                        <option value="ipr">8. Trademark & Copyright Act - IPR Infringement Cease & Desist</option>
                        <option value="rera">9. Section 18 RERA Act 2016 - Builder Delay & Refund Notice</option>
                        <option value="sec80cpc">10. Section 80 CPC - 60-Day Statutory Notice Against Government</option>
                        <option value="restitution">11. Section 9 HMA - Restitution of Conjugal Rights Notice</option>
                        <option value="partition">12. Hindu Succession Act - Ancestral Property Partition Notice</option>
                        <option value="rti">13. Right to Information Act 2005 - Form A Application</option>
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="modern-label">Sender / Client Name</label>
                        <input type="text" id="senderName" class="form-control modern-input" value="XYZ Enterprises Pvt Ltd" oninput="updateDraftPreview()" />
                    </div>
                    <div class="col-6">
                        <label class="modern-label">Sender Advocate & Bar No.</label>
                        <input type="text" id="advocateName" class="form-control modern-input" value="Adv. Arvind Saxena (D/1420/2012)" oninput="updateDraftPreview()" />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="modern-label">Recipient / Opposite Party</label>
                        <input type="text" id="recipientName" class="form-control modern-input" value="ABC Global Corporation Ltd" oninput="updateDraftPreview()" />
                    </div>
                    <div class="col-6">
                        <label class="modern-label">Demand Amount / Value</label>
                        <input type="text" id="amount" class="form-control modern-input" value="₹45,00,000" oninput="updateDraftPreview()" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="modern-label">Reference No. / Cheque / Agreement / Property</label>
                    <input type="text" id="chequeNo" class="form-control modern-input" value="CHQ-884910 dated 15-Sep-2026 drawn on HDFC Bank" oninput="updateDraftPreview()" />
                </div>

                <div class="mb-3">
                    <label class="modern-label">Notice Dispatch City / Jurisdiction</label>
                    <input type="text" id="dispatchCity" class="form-control modern-input" value="New Delhi" oninput="updateDraftPreview()" />
                </div>

                <div class="d-flex gap-2 pt-2">
                    <button type="button" class="btn btn-modern-primary w-50 py-2" onclick="printSinglePageDraft()">
                        <i class="fa-solid fa-print me-1"></i> Print / 1-Page PDF
                    </button>
                    <button type="button" class="btn btn-modern-cyan w-50 py-2" onclick="copyDraftText()">
                        <i class="fa-regular fa-copy me-1"></i> Copy Text
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="glass-panel p-4 h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-file-lines text-warning"></i> 1-Page Standard A4 Letterhead Preview
                </h5>
                <span class="badge bg-success bg-opacity-25 text-success">Statutory 1-Page Fit</span>
            </div>

            <div class="p-4 rounded-3 flex-grow-1 overflow-auto bg-white text-dark small" id="draftPreviewPaper" style="max-height: 560px; line-height: 1.38; font-size: 13px; border: 1px solid #cbd5e1; font-family: 'Times New Roman', Times, serif; color: #0f172a !important;">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateDraftPreview() {
            const sender = $('#senderName').val() || 'XYZ Client';
            const adv = $('#advocateName').val() || 'Advocate Legal Counsel';
            const recipient = $('#recipientName').val() || 'ABC Opposite Party';
            const amt = $('#amount').val() || '₹0';
            const chq = $('#chequeNo').val() || 'Reference Agreement / Docket Ref';
            const city = $('#dispatchCity').val() || 'New Delhi';
            const type = $('#draftType').val();
            const today = new Date().toLocaleDateString('en-GB');

            let draftText = '';

            if (type === '138') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">LEGAL DEMAND NOTICE</h4>
                        <small style="font-weight: bold;">UNDER SECTION 138 OF THE NEGOTIABLE INSTRUMENTS ACT, 1881 (AS AMENDED)</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>DISPATCH:</strong> SPEED POST A.D. / COURIER</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;">
                        <strong>TO:</strong><br/>
                        ${recipient}<br/>
                        Authorized Signatory / Account Drawer
                    </div>
                    <div style="margin-bottom: 8px;">
                        <strong>FROM:</strong> ${adv}, Advocate, High Court Bar<br/>
                        <strong>UNDER INSTRUCTIONS FROM CLIENT:</strong> ${sender}
                    </div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <p style="margin-bottom: 6px;">Under instructions and on behalf of my Client named above, I serve upon you this Statutory Demand Notice:</p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>In discharge of your legally enforceable debt/liability, you issued cheque <strong>${chq}</strong> for <strong>${amt}</strong> to my Client.</li>
                        <li>Upon presentment within validity, the banker returned said cheque unpaid with memo <strong>"FUNDS INSUFFICIENT / EXCEEDS ARRANGEMENT"</strong>.</li>
                        <li>You are hereby called upon to pay the said sum of <strong>${amt}</strong> within <strong>15 (Fifteen) days</strong> of notice receipt.</li>
                        <li>In default, criminal prosecution under Section 138 NI Act and Section 420 IPC/BNS shall be initiated at your sole cost.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Complainant / Payee</small>
                    </div>
                `;
            } else if (type === 'eviction') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">NOTICE OF TERMINATION OF TENANCY & EVICTION</h4>
                        <small style="font-weight: bold;">UNDER SECTION 106 OF THE TRANSFER OF PROPERTY ACT, 1882</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>DISPATCH:</strong> REGISTERED POST A.D.</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO TENANT:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv}, Counsel for Landlord <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>You were inducted as tenant in demised premises under lease (${chq}) at agreed monthly rental.</li>
                        <li>You have persistently defaulted in payment of rent, accumulating gross arrears of <strong>${amt}</strong>.</li>
                        <li>My Client hereby terminates your tenancy and calls upon you to deliver vacant possession within <strong>15 (Fifteen) days</strong>.</li>
                        <li>Clear the outstanding sum of <strong>${amt}</strong> immediately, failing which eviction suit with mesne profits shall be filed.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Landlord</small>
                    </div>
                `;
            } else if (type === 'recovery') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">FORMAL LEGAL NOTICE FOR SUMMARY DEBT RECOVERY</h4>
                        <small style="font-weight: bold;">ORDER XXXVII OF THE CODE OF CIVIL PROCEDURE, 1908</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> SPEED POST / REGISTERED E-MAIL</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO DEBTOR:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of Creditor <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>Against supplied goods/invoices (${chq}), an admitted liquidated debt of <strong>${amt}</strong> remains unpaid.</li>
                        <li>Despite repeated reminders and balance confirmations, you failed to clear the legitimate outstanding.</li>
                        <li>Pay the full liquidated sum of <strong>${amt}</strong> with 18% p.a. interest within <strong>15 days</strong> of receipt.</li>
                        <li>In default, a Summary Suit under Order 37 CPC and attachment before judgment shall be instituted.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Plaintiff</small>
                    </div>
                `;
            } else if (type === 'consumer') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">LEGAL NOTICE FOR DEFICIENCY OF SERVICE & UNFAIR TRADE</h4>
                        <small style="font-weight: bold;">UNDER THE CONSUMER PROTECTION ACT, 2019</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> SPEED POST A.D.</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO SERVICE PROVIDER:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of Consumer <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>My Client availed product/services (${chq}) by paying total consideration of <strong>${amt}</strong>.</li>
                        <li>The goods/services suffered from critical latent defects causing immense monetary loss and distress.</li>
                        <li>You are called upon to refund <strong>${amt}</strong> with ₹1,00,000 compensation within <strong>15 days</strong>.</li>
                        <li>Failing which, a formal complaint before the District Consumer Disputes Redressal Commission shall be filed.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Complainant</small>
                    </div>
                `;
            } else if (type === 'salary') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">LEGAL DEMAND NOTICE FOR UNPAID SALARY & STATUTORY ARREARS</h4>
                        <small style="font-weight: bold;">PAYMENT OF WAGES ACT, 1936 & INDUSTRIAL DISPUTES ACT, 1947</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> REGISTERED POST A.D. & OFFICIAL E-MAIL</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO EMPLOYER / MANAGEMENT:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of Employee <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Dear Sirs,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>My Client served your organization diligently under employment ref (${chq}).</li>
                        <li>You have unlawfully withheld earned salary, leave encashment, and severance totaling <strong>${amt}</strong>.</li>
                        <li>Remit the full undisputed dues of <strong>${amt}</strong> into my Client's bank account within <strong>15 days</strong>.</li>
                        <li>In default, proceedings before the Labour Commissioner and NCLT/Civil Court shall be instituted at your cost.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Employee</small>
                    </div>
                `;
            } else if (type === 'defamation') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">CEASE & DESIST NOTICE FOR DEFAMATION & CLAIM FOR DAMAGES</h4>
                        <small style="font-weight: bold;">SECTIONS 499 & 500 IPC / BHARATIYA NYAYA SANHITA & CIVIL LAW</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>DISPATCH:</strong> SPEED POST & DIGITAL NOTICE</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO OFFENDER:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>You published false, scurrilous, and defamatory statements against my Client via (${chq}).</li>
                        <li>Said publication was malicious, calculatingly lowering my Client's stellar reputation in society.</li>
                        <li>Tender an unconditional written public apology and pay damages of <strong>${amt}</strong> within <strong>7 days</strong>.</li>
                        <li>In default, criminal prosecution under Sec 500 IPC/BNS and a civil defamation suit shall follow.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Aggrieved Party</small>
                    </div>
                `;
            } else if (type === 'contract') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">LEGAL NOTICE FOR BREACH OF CONTRACT & SPECIFIC PERFORMANCE</h4>
                        <small style="font-weight: bold;">UNDER THE INDIAN CONTRACT ACT, 1872 & SPECIFIC RELIEF ACT, 1963</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> REGISTERED POST A.D.</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>You entered into a binding commercial contract with my Client dated (${chq}).</li>
                        <li>My Client remained ready and willing to perform all reciprocal obligations thereunder.</li>
                        <li>You committed fundamental breach, causing damages quantified at <strong>${amt}</strong>.</li>
                        <li>Perform your contractual obligations and remit <strong>${amt}</strong> within <strong>15 days</strong>.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Claimant</small>
                    </div>
                `;
            } else if (type === 'ipr') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">CEASE & DESIST NOTICE - TRADEMARK & COPYRIGHT INFRINGEMENT</h4>
                        <small style="font-weight: bold;">TRADE MARKS ACT, 1999 & COPYRIGHT ACT, 1957</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>DISPATCH:</strong> SPEED POST & LEGAL NOTICE PORTAL</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO INFRINGER:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of Proprietor <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>My Client is the registered owner and prior user of intellectual property (${chq}).</li>
                        <li>You are illegally passing off and infringing said trademark/copyright for illicit commercial gain.</li>
                        <li>Immediately cease, desist, deliver up infringing stock, and pay damages of <strong>${amt}</strong> within <strong>7 days</strong>.</li>
                        <li>Failing compliance, an IP suit for permanent injunction, rendition of accounts, and punitive damages will be filed.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for IP Proprietor</small>
                    </div>
                `;
            } else if (type === 'rera') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">STATUTORY NOTICE FOR POSSESSION DELAY & FULL REFUND</h4>
                        <small style="font-weight: bold;">SECTION 18 OF REAL ESTATE (REGULATION & DEVELOPMENT) ACT, 2016 (RERA)</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> REGISTERED POST A.D.</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO BUILDER / PROMOTER:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of Allottee <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>My Client booked apartment/unit (${chq}) and paid total milestone consideration of <strong>${amt}</strong>.</li>
                        <li>You breached the agreed possession deadline without lawful justification or OC.</li>
                        <li>Refund the principal sum of <strong>${amt}</strong> along with SBI MCLR+2% statutory interest within <strong>30 days</strong>.</li>
                        <li>In default, complaint under Section 18/31 of RERA before the Real Estate Regulatory Authority shall be lodged.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Allottee</small>
                    </div>
                `;
            } else if (type === 'sec80cpc') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">STATUTORY 60-DAY NOTICE AGAINST GOVERNMENT / PUBLIC OFFICER</h4>
                        <small style="font-weight: bold;">SECTION 80 OF THE CODE OF CIVIL PROCEDURE, 1908</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> REGISTERED POST A.D.</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO SECRETARY / PUBLIC OFFICER:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>Notice is hereby given of intention to institute a suit against the Union/State authority in matter (${chq}).</li>
                        <li>The cause of action arose upon unlawful administrative inaction/decision regarding claim of <strong>${amt}</strong>.</li>
                        <li>Rectify the grievance and release the legitimate compensation of <strong>${amt}</strong> within <strong>60 days</strong>.</li>
                        <li>Upon expiry of 60 days without satisfaction, a civil writ/suit will be instituted in the High Court.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Notice Giver</small>
                    </div>
                `;
            } else if (type === 'restitution') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">LEGAL NOTICE FOR RESTITUTION OF CONJUGAL RIGHTS</h4>
                        <small style="font-weight: bold;">UNDER SECTION 9 OF THE HINDU MARRIAGE ACT, 1955</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> SPEED POST A.D.</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO SPOUSE:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of Spouse <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Dear Madam/Sir,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>Solemnization of marriage took place per Hindu rites on reference date (${chq}).</li>
                        <li>You withdrew from the society of my Client without any reasonable cause or valid excuse.</li>
                        <li>You are called upon to return to the matrimonial home and resume cohabitation within <strong>15 days</strong>.</li>
                        <li>Failing which, a Petition under Section 9 HMA shall be filed before the Principal Family Court.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Petitioner</small>
                    </div>
                `;
            } else if (type === 'partition') {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">LEGAL NOTICE FOR PARTITION & SEPARATE POSSESSION</h4>
                        <small style="font-weight: bold;">UNDER THE HINDU SUCCESSION ACT, 1956 & PARTITION ACT, 1893</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>MODE:</strong> REGISTERED POST A.D.</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO CO-PARCENER / CO-SHARER:</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>FROM:</strong> ${adv} on behalf of Co-Sharer <strong>${sender}</strong></div>
                    <p style="margin-bottom: 6px;"><strong>Sir/Madam,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>The ancestral coparcenary properties described under schedule (${chq}) are joint and undivided.</li>
                        <li>My Client holds an undisputed legitimate equal share valued at approximately <strong>${amt}</strong>.</li>
                        <li>Agree to effect partition by metes and bounds and handover separate physical possession within <strong>15 days</strong>.</li>
                        <li>In default, a Civil Partition Suit for preliminary decree and appointment of Court Commissioner will be filed.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${adv})</strong></p>
                        <small>Advocate for Coparcener</small>
                    </div>
                `;
            } else {
                draftText = `
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 6px; margin-bottom: 12px;">
                        <h4 style="margin: 0; font-size: 16px; font-weight: bold; text-transform: uppercase;">APPLICATION FOR OBTAINING INFORMATION UNDER RTI ACT, 2005</h4>
                        <small style="font-weight: bold;">FORM-A (SECTION 6(1) OF THE RIGHT TO INFORMATION ACT, 2005)</small>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 10px;">
                        <div><strong>DISPATCH:</strong> SPEED POST / RTI PORTAL</div>
                        <div><strong>DATE:</strong> ${today} | <strong>PLACE:</strong> ${city}</div>
                    </div>
                    <div style="margin-bottom: 8px;"><strong>TO PUBLIC INFORMATION OFFICER (PIO):</strong> ${recipient}</div>
                    <div style="margin-bottom: 8px;"><strong>APPLICANT:</strong> ${sender} (Represented by ${adv})</div>
                    <p style="margin-bottom: 6px;"><strong>Respected PIO,</strong></p>
                    <ol style="margin-bottom: 8px; padding-left: 20px;">
                        <li>Kindly furnish certified copies of records, file notings, and sanction orders regarding (${chq}).</li>
                        <li>Statutory application fee of ₹10 (IPO/Online) is affixed herewith.</li>
                        <li>I am a Citizen of India and the requested information does not fall under Section 8 or 9 exemptions.</li>
                        <li>Kindly provide the requested information within the mandatory statutory period of <strong>30 days</strong>.</li>
                    </ol>
                    <div style="margin-top: 14px; text-align: right;">
                        <p style="margin: 0;"><strong>(${sender})</strong></p>
                        <small>Applicant / Citizen of India</small>
                    </div>
                `;
            }

            $('#draftPreviewPaper').html(draftText);
        }

        function printSinglePageDraft() {
            const printContent = document.getElementById('draftPreviewPaper').innerHTML;
            let iframe = document.getElementById('print_draft_iframe');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'print_draft_iframe';
                iframe.style.position = 'fixed';
                iframe.style.right = '0';
                iframe.style.bottom = '0';
                iframe.style.width = '0';
                iframe.style.height = '0';
                iframe.style.border = '0';
                document.body.appendChild(iframe);
            }
            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Statutory Legal Notice</title>
                    <style>
                        @@page {
                            size: A4 portrait;
                            margin: 12mm 15mm;
                        }
                        * {
                            box-sizing: border-box;
                            margin: 0;
                            padding: 0;
                            box-shadow: none !important;
                            text-shadow: none !important;
                            filter: none !important;
                        }
                        html, body {
                            background: #ffffff !important;
                            color: #000000 !important;
                            font-family: 'Times New Roman', Times, serif !important;
                            font-size: 11.5pt;
                            line-height: 1.38;
                            margin: 0;
                            padding: 0;
                        }
                        p, div, li, span, small, strong, h4 {
                            color: #000000 !important;
                        }
                        ol {
                            padding-left: 20px;
                            margin-top: 6px;
                            margin-bottom: 8px;
                        }
                        li {
                            margin-bottom: 6px;
                        }
                    </style>
                </head>
                <body>
                    <div>${printContent}</div>
                </body>
                </html>
            `);
            doc.close();
            setTimeout(() => {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
            }, 250);
        }

        function copyDraftText() {
            const text = $('#draftPreviewPaper').text();
            navigator.clipboard.writeText(text).then(() => {
                alert('Statutory notice text copied to clipboard successfully!');
            });
        }

        $(document).ready(function () {
            updateDraftPreview();
        });
    </script>
}
