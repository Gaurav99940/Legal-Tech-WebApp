@model LT.Model.ViewModels.UserLogin
@{
    ViewData["Title"] = "Secure Portal Authentication";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Login - LegalTech AI Portal</title>
    
    <link rel="shortcut icon" type="image/x-icon" href="/images/fevicon.ico" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <link href="~/css/modern-legaltech.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

    <style>
        :root, [data-theme="dark"], body:not([data-theme="light"]) {
            --bs-body-color: #ffffff !important;
            color-scheme: dark !important;
        }
        input, select, textarea, .form-control, .modern-input, .input-group .form-control {
            color: #ffffff !important;
            -webkit-text-fill-color: #ffffff !important;
            caret-color: #ffffff !important;
            background-color: #0f172a !important;
            border: 1px solid rgba(255, 255, 255, 0.25) !important;
        }
        input:focus, select:focus, textarea:focus, .form-control:focus, .modern-input:focus, .input-group .form-control:focus {
            color: #ffffff !important;
            -webkit-text-fill-color: #ffffff !important;
            caret-color: #ffffff !important;
            background-color: #141e33 !important;
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.35) !important;
        }
        [data-theme="light"] input, [data-theme="light"] select, [data-theme="light"] textarea,
        [data-theme="light"] .form-control, [data-theme="light"] .modern-input, [data-theme="light"] .input-group .form-control,
        body.light-theme input, body.light-theme select, body.light-theme textarea,
        body.light-theme .form-control, body.light-theme .modern-input, body.light-theme .input-group .form-control {
            color: #0f172a !important;
            -webkit-text-fill-color: #0f172a !important;
            caret-color: #0f172a !important;
            background-color: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
        }
        [data-theme="light"] input:focus, [data-theme="light"] select:focus, [data-theme="light"] textarea:focus,
        [data-theme="light"] .form-control:focus, [data-theme="light"] .modern-input:focus, [data-theme="light"] .input-group .form-control:focus,
        body.light-theme input:focus, body.light-theme select:focus, body.light-theme textarea:focus,
        body.light-theme .form-control:focus, body.light-theme .modern-input:focus, body.light-theme .input-group .form-control:focus {
            color: #0f172a !important;
            -webkit-text-fill-color: #0f172a !important;
            caret-color: #0f172a !important;
            background-color: #ffffff !important;
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2) !important;
        }
    </style>

    <script>
        (function () {
            const savedTheme = localStorage.getItem('legaltech_theme') || 'dark';
            if (savedTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>
<body class="d-flex align-items-center justify-content-center py-5" style="min-height: 100vh;">
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
        <button class="btn-theme-toggle" id="themeToggleBtn" title="Toggle Bright / Dark Mode" type="button">
            <i class="fa-solid fa-sun" id="themeToggleIcon"></i>
        </button>
    </div>

    <div class="container px-3 py-3 position-relative" style="z-index: 2; max-width: 480px;">
        <div class="glass-panel p-3 p-sm-4 p-md-5">
            <div class="text-center mb-4">
                <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3">
                    <div style="width: 48px; height: 48px; border-radius: 14px; background: var(--grad-primary); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);">
                        <i class="fa-solid fa-scale-balanced text-white fs-4"></i>
                    </div>
                    <span class="fs-3 fw-bold text-white">Legal<span class="text-gradient">Tech</span></span>
                </a>
                <h4 class="text-white fw-bold mb-1">Welcome Back</h4>
                <p class="text-secondary small mb-0">Sign in to access encrypted case dockets and statutory AI</p>
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info d-flex align-items-center gap-2 p-3 rounded-3 mb-3 small" style="background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.35); color: #38bdf8;">
                    <i class="fa-solid fa-circle-info fs-5"></i>
                    <div>@ViewBag.Message</div>
                </div>
            }

            <form id="loginForm" method="post" asp-controller="Home" asp-action="Index" autocomplete="off">
                <div class="mb-3">
                    <label class="modern-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-secondary"><i class="fa-solid fa-envelope"></i></span>
                        <input id="emailInput" asp-for="emailid" type="email" class="form-control modern-input" placeholder="e.g., xyz@example.com" autocomplete="off" required />
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="modern-label mb-0">Password</label>
                        <a href="#" class="small text-info text-decoration-none" style="font-size: 0.78rem;">Forgot?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-secondary"><i class="fa-solid fa-lock"></i></span>
                        <input id="passwordInput" asp-for="password" type="password" class="form-control modern-input" placeholder="Enter password" autocomplete="new-password" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-modern-primary w-100 py-3 mb-3">
                    <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Access Legal Portal
                </button>
            </form>

            <div class="text-center pt-3 border-top border-secondary border-opacity-25">
                <p class="small text-secondary mb-2">
                    Don't have an account? <a asp-controller="Home" asp-action="SignUp" class="text-gradient fw-bold text-decoration-none">Sign Up Here</a>
                </p>
                <a href="/" class="small text-muted text-decoration-none hover-white">
                    <i class="fa-solid fa-arrow-left me-1"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function updateThemeIcons() {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            const icon = document.getElementById('themeToggleIcon');
            if (icon) {
                if (isLight) {
                    icon.className = 'fa-solid fa-moon text-primary';
                } else {
                    icon.className = 'fa-solid fa-sun text-warning';
                }
            }
        }
        updateThemeIcons();

        document.getElementById('themeToggleBtn')?.addEventListener('click', function () {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            const newTheme = isLight ? 'dark' : 'light';
            if (newTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            } else {
                document.documentElement.removeAttribute('data-theme');
            }
            localStorage.setItem('legaltech_theme', newTheme);
            updateThemeIcons();
        });
    </script>
</body>
</html>